@model BstSolutions.ViewModels.Employee.CreateEmployeeViewModel
@{
    ViewData["Title"] = "Create Employee";
}

<h1 class="h3 mb-3">Create Employee</h1>

<form id="employeeForm" asp-action="Create" method="post" class="col-md-6">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label asp-for="FirstName" class="form-label"></label>
        <input asp-for="FirstName" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="LastName" class="form-label"></label>
        <input asp-for="LastName" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>
<span id="generalError" class="text-danger d-block mt-3"></span>

@section Scripts {
    <script>
        const employeeForm = document.getElementById("employeeForm");
        const generalError = document.getElementById("generalError");

        const createUrl = '@Url.Action("Create", "Employee")';

        employeeForm.addEventListener("submit", async function (e) {
            e.preventDefault();
            generalError.innerHTML = "";

            const formData = new FormData(employeeForm);

            const response = await fetch(createUrl, {
                method: "POST",
                headers: {
                    "RequestVerificationToken": formData.get("__RequestVerificationToken"),
                    "X-Requested-With": "XMLHttpRequest"
                },
                body: new URLSearchParams(formData)
            });

            const result = await response.json();

            if (response.ok) {
                window.location.href = result.redirectUrl;
            } else if (result.message) {
                generalError.textContent = result.message;
            } else {
                generalError.innerHTML = Object.values(result)
                    .flat()
                    .map(error => `<div>${error}</div>`)
                    .join("");
            }
        });
    </script>
}
