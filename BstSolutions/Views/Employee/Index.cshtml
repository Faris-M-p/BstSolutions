@model IEnumerable<BstSolutions.ViewModels.Employee.EmployeeListItemViewModel>
@{
    ViewData["Title"] = "Employees";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Employees</h1>
    <a class="btn btn-primary" asp-action="Create">Create Employee</a>
</div>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>#</th>
            <th>Name</th>
            <th>Email</th>
            <th>Status</th>
            <th>Created Date</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @if (!Model.Any())
    {
        <tr>
            <td colspan="6" class="text-center">No employees found.</td>
        </tr>
    }
    else
    {
        var rowNumber = 0;
        foreach (var item in Model)
        {
            rowNumber++;
            <tr>
                <td>@rowNumber</td>
                <td>@item.FullName</td>
                <td>@item.Email</td>
                <td>@(item.IsActive ? "Active" : "Inactive")</td>
                <td>@item.CreatedDate.ToLocalTime().ToString("yyyy-MM-dd")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                </td>
            </tr>
        }
    }
    </tbody>
</table>
