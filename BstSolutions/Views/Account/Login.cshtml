@model LoginViewModel
@{
    ViewData["Title"] = "Login";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<h1 class="h3 mb-3">Login</h1>
<p class="text-muted">Sign in with your application user account.</p>

<form id="loginForm" asp-action="Login" method="post" class="col-md-5" novalidate>
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="username" />
    </div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" autocomplete="current-password" />
    </div>
    

    <button type="submit" class="btn btn-primary">Login</button>
</form>
<span id="generalError" class="text-danger d-block mt-3"></span>

@section Scripts {
    <script>
        const loginForm = document.getElementById("loginForm");
        const generalError = document.getElementById("generalError");

        const loginUrl = '@Url.Action("Login", "Account", new { returnUrl })';

        loginForm.addEventListener("submit", async function (e) {
            e.preventDefault();
            generalError.innerHTML = "";

            const formData = new FormData(loginForm);

            const response = await fetch(loginUrl, {
                method: "POST",
                headers: {
                    "RequestVerificationToken": formData.get("__RequestVerificationToken"),
                    "X-Requested-With": "XMLHttpRequest"
                },
                body: new URLSearchParams(formData)
            });

            const result = await response.json();

            if (response.ok) {
                window.location.href = result.redirectUrl;
            } else if (result.message) {
                generalError.textContent = result.message;
            } else {
                generalError.innerHTML = Object.values(result)
                    .flat()
                    .map(error => `<div>${error}</div>`)
                    .join("");
            }
        });
    </script>
}
