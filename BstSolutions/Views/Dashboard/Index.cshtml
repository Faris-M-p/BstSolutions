@model BstSolutions.ViewModels.Dashboard.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1 class="h3 mb-3">Dashboard</h1>

<div class="row g-3 mb-4">
    <div class="col-md-2">
        <div class="border rounded p-3 text-center">
            <div class="text-muted">Total</div>
            <div class="fs-4 fw-semibold">@Model.TotalTasks</div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="border rounded p-3 text-center">
            <div class="text-muted">New</div>
            <div class="fs-4 fw-semibold">@Model.NewTasks</div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="border rounded p-3 text-center">
            <div class="text-muted">In Progress</div>
            <div class="fs-4 fw-semibold">@Model.InProgressTasks</div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="border rounded p-3 text-center">
            <div class="text-muted">Completed</div>
            <div class="fs-4 fw-semibold">@Model.CompletedTasks</div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="border rounded p-3 text-center">
            <div class="text-muted">Overdue</div>
            <div class="fs-4 fw-semibold">@Model.OverdueTasks</div>
        </div>
    </div>
</div>

<h2 class="h5">Five nearest upcoming tasks</h2>
<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>#</th>
            <th>Title</th>
            <th>Employee</th>
            <th>Priority</th>
            <th>Status</th>
            <th>Due Date</th>
        </tr>
    </thead>
    <tbody>
    @if (!Model.UpcomingTasks.Any())
    {
        <tr>
            <td colspan="6" class="text-center">No upcoming tasks.</td>
        </tr>
    }
    else
    {
        var rowNumber = 0;
        foreach (var item in Model.UpcomingTasks)
        {
            rowNumber++;
            <tr>
                <td>@rowNumber</td>
                <td>
                    <a asp-controller="Task" asp-action="Details" asp-route-id="@item.Id">@item.Title</a>
                </td>
                <td>@item.EmployeeName</td>
                <td>@item.Priority</td>
                <td>@item.Status</td>
                <td>@item.DueDate.ToString("yyyy-MM-dd")</td>
            </tr>
        }
    }
    </tbody>
</table>
